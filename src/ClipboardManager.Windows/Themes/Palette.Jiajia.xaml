<!-- 夹夹主题 · 活页版：青灰桌面、活页纸、铅笔描边、荧光笔标记选中、品牌青 #10736B（RGB 16,115,107）。
     只覆盖与标准主题不同的键，须作为最后一个合并字典加载（见 ThemeService）；键必须是 Palette.xaml 键的子集。
     设计依据：docs/design/2026-11-19-jiajia-looseleaf/（prototype.html 与 jiajia-looseleaf-spec.md）。
     可访问性：正文 14.4、次要 9.3、元信息 6.2（纸底）；元信息在桌面 5.0、在选中底 5.9；白字在品牌青 5.6。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 墨 -->
    <SolidColorBrush x:Key="LabelPrimaryBrush" Color="#FF2A2420" />
    <SolidColorBrush x:Key="LabelSecondaryBrush" Color="#FF4A423B" />
    <SolidColorBrush x:Key="LabelTertiaryBrush" Color="#FF625C55" />

    <!-- 品牌青：夹子、主按钮、焦点、勾选。 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF10736B" />
    <SolidColorBrush x:Key="AccentBrandBrush" Color="#FF10736B" />
    <SolidColorBrush x:Key="AccentBrandStrongBrush" Color="#FF0B5A54" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF2F6B45" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FF97481F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFB33A26" />

    <!-- 桌面：标题栏、页签带、页脚。 -->
    <SolidColorBrush x:Key="WindowVibrancyBrush" Color="#FFD3E5DF" />
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#FFD3E5DF" />
    <SolidColorBrush x:Key="WindowChromeBrush" Color="#FFD3E5DF" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#FFD3E5DF" />

    <!-- 活页纸：内容区。 -->
    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#FFFBF8F1" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFBF8F1" />
    <SolidColorBrush x:Key="SurfaceOpaqueBrush" Color="#FFFBF8F1" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFBF8F1" />
    <SolidColorBrush x:Key="PopoverBrush" Color="#FFFBF8F1" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFA9C9BE" />

    <!-- 卡片：行、输入框、按钮。 -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#FFFFFDF8" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#FFF5F0E4" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#FFEFE9DC" />
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#FFF5F2EA" />
    <SolidColorBrush x:Key="SegmentedTrackBrush" Color="#FFEFE9DC" />
    <SolidColorBrush x:Key="ThumbnailBackdropBrush" Color="#FFEFE9DC" />
    <SolidColorBrush x:Key="SelectionInactiveBrush" Color="#FFEFE9DC" />

    <!-- 铅笔线 -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FFD9D0C1" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FFD9D0C1" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FF8E887F" />

    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0A3A2C1E" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#143A2C1E" />

    <!-- 荧光笔 = 选中。 -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#FFFFF3BF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFFCEFA8" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FFC9C0B1" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF8E887F" />
    <SolidColorBrush x:Key="TooltipBrush" Color="#FF2A2420" />

    <CornerRadius x:Key="RadiusSmall">3</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">4</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">6</CornerRadius>
    <CornerRadius x:Key="RadiusPill">4</CornerRadius>

    <!-- 行：卡片 + 1.25 铅笔线；选中为淡荧光底 + 墨线 + 墨影 + 品牌青夹子 + 折角。 -->
    <CornerRadius x:Key="RowCornerRadius">4</CornerRadius>
    <Thickness x:Key="RowBorderThickness">1.25</Thickness>
    <Thickness x:Key="RowCardInset">0,4,0,4</Thickness>
    <SolidColorBrush x:Key="RowCardBrush" Color="#FFFFFDF8" />
    <SolidColorBrush x:Key="RowBorderBrush" Color="#FFD9D0C1" />
    <SolidColorBrush x:Key="RowSelectedBorderBrush" Color="#FF2A2420" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#FFFFFDF8" />
    <SolidColorBrush x:Key="RowSelectedMetaBrush" Color="#FF4A423B" />
    <Visibility x:Key="RowSeparatorVisibility">Collapsed</Visibility>
    <Thickness x:Key="SelectionEdgeThickness">0</Thickness>
    <SolidColorBrush x:Key="SelectionEdgeBrush" Color="#FF2A2420" />
    <Visibility x:Key="SelectionDecorVisibility">Visible</Visibility>
    <SolidColorBrush x:Key="SelectionDecorBrush" Color="#FF2A2420" />
    <Visibility x:Key="EmptyPetVisibility">Visible</Visibility>

    <!-- 活页动效：悬停上浮 1px 出 2,2 淡影，按下下沉 1px；选中墨影 3px；新记录从上方 10px 落下；页签荧光笔划过。 -->
    <sys:Double x:Key="SelectionShadowOffset">3</sys:Double>
    <sys:Double x:Key="RowHoverLift">-1</sys:Double>
    <sys:Double x:Key="RowPressSink">1</sys:Double>
    <SolidColorBrush x:Key="RowHoverShadowBrush" Color="#383A2C1E" />
    <sys:Double x:Key="RowDropDistance">10</sys:Double>
    <sys:Boolean x:Key="SelectionPop">True</sys:Boolean>
    <sys:Boolean x:Key="NavSelectWipe">True</sys:Boolean>

    <!-- 空状态便签：淡荧光底、2,3 淡影、半透明纸胶带，倾斜 −1.5°。 -->
    <Visibility x:Key="EmptyNoteVisibility">Visible</Visibility>
    <SolidColorBrush x:Key="EmptyNoteBrush" Color="#FFFCEFA8" />
    <SolidColorBrush x:Key="EmptyNoteShadowBrush" Color="#243A2C1E" />
    <SolidColorBrush x:Key="EmptyNoteTapeBrush" Color="#BFF6F4EC" />
    <SolidColorBrush x:Key="EmptyNoteTapeBorderBrush" Color="#598C8778" />
    <sys:Double x:Key="EmptyNoteAngle">-1.5</sys:Double>
    <Thickness x:Key="EmptyNoteMargin">0,14,0,0</Thickness>
    <Thickness x:Key="EmptyNotePadding">16,12,16,14</Thickness>

    <Visibility x:Key="PaperGrainVisibility">Visible</Visibility>
    <Visibility x:Key="KeycapVisibility">Visible</Visibility>

    <!-- 页签：荧光笔块，不规则圆角，无描边、无下划线。 -->
    <CornerRadius x:Key="NavPillRadius">6,3,7,3</CornerRadius>
    <Thickness x:Key="NavPillBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="NavPillBorderBrush" Color="#FF2A2420" />
    <Thickness x:Key="NavBottomBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="NavMarkBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#FFF8DC4C" />
    <SolidColorBrush x:Key="NavSelectedForegroundBrush" Color="#FF2A2420" />

    <CornerRadius x:Key="ChipCornerRadius">5,3,6,3</CornerRadius>
    <SolidColorBrush x:Key="ChipCheckedBackgroundBrush" Color="#FFFCEFA8" />
    <SolidColorBrush x:Key="ChipMarkBrush" Color="#00FFFFFF" />

    <CornerRadius x:Key="SearchCornerRadius">4</CornerRadius>
    <SolidColorBrush x:Key="SearchFillBrush" Color="#FFFFFDF8" />

    <sys:String x:Key="CopyEmptyHistory">夹夹在等你复制点什么</sys:String>
    <sys:String x:Key="CopyPausedHistory">已暂停监听，夹夹在打盹</sys:String>
    <sys:String x:Key="CopyNoResults">夹夹没找到，换个关键词试试？</sys:String>

    <!-- 错位实影，不模糊。 -->
    <DropShadowEffect x:Key="PopoverShadow" BlurRadius="0" ShadowDepth="3" Direction="315" Opacity="0.18" Color="#FF3A2C1E" />

</ResourceDictionary>
