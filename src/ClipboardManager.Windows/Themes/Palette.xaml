<!-- 0.8.1 Warm Paper: Claude-style discipline — warm porcelain ground, near-black ink, single terracotta accent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Microsoft YaHei UI, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeMeta">11</sys:Double>
    <sys:Double x:Key="FontSizeIcon">14</sys:Double>

    <!-- 间距刻度：带内 4/8，带间 12/16。新增控件一律引用此表，禁止魔法数。 -->
    <sys:Double x:Key="SpacingXS">4</sys:Double>
    <sys:Double x:Key="SpacingSM">8</sys:Double>
    <sys:Double x:Key="SpacingMD">12</sys:Double>
    <sys:Double x:Key="SpacingLG">16</sys:Double>

    <!-- 墨色：暖中性，蓝味归零。 -->
    <Color x:Key="LabelPrimaryColor">#FF1F1E1C</Color>
    <Color x:Key="LabelSecondaryColor">#FF6E6B63</Color>
    <Color x:Key="LabelTertiaryColor">#FFA39F94</Color>

    <!-- 唯一点缀：赤陶。只允许出现在页签指示、选中标记、主按钮与产品标记。 -->
    <Color x:Key="AccentColor">#FFD97757</Color>
    <Color x:Key="AccentBrandColor">#FFD97757</Color>
    <Color x:Key="AccentBrandStrongColor">#FFB85C38</Color>

    <Color x:Key="SuccessColor">#FF788C5D</Color>
    <Color x:Key="WarningColor">#FFC4653F</Color>
    <Color x:Key="DangerColor">#FF9C3D28</Color>

    <SolidColorBrush x:Key="LabelPrimaryBrush" Color="{StaticResource LabelPrimaryColor}" />
    <SolidColorBrush x:Key="LabelSecondaryBrush" Color="{StaticResource LabelSecondaryColor}" />
    <SolidColorBrush x:Key="LabelTertiaryBrush" Color="{StaticResource LabelTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentBrandBrush" Color="{StaticResource AccentBrandColor}" />
    <SolidColorBrush x:Key="AccentBrandStrongBrush" Color="{StaticResource AccentBrandStrongColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <!-- 暖纸工作面：窗面与工作面只差半阶温调。 -->
    <SolidColorBrush x:Key="WindowVibrancyBrush" Color="#FFF5F4EE" />
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#FFF5F4EE" />

    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#FFFAF9F5" />
    <SolidColorBrush x:Key="WindowChromeBrush" Color="#FFF5F4EE" />

    <SolidColorBrush x:Key="SegmentedTrackBrush" Color="#FFEDEAE0" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFAF9F5" />
    <SolidColorBrush x:Key="SurfaceOpaqueBrush" Color="#FFFAF9F5" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#FFF5F4EE" />

    <SolidColorBrush x:Key="SeparatorBrush" Color="#FFE8E6DC" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FFE8E6DC" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FFD0CDC2" />

    <SolidColorBrush x:Key="ControlFillBrush" Color="#FFF1EFE7" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#FFE9E6DC" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#FFE0DDD2" />
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#FFF5F4EE" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#101F1E1C" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#201F1E1C" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FFF0E9DE" />
    <SolidColorBrush x:Key="SelectionInactiveBrush" Color="#FFEDEAE0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF7EDE4" />
    <SolidColorBrush x:Key="ThumbnailBackdropBrush" Color="#FFEFECE4" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FFB9B5AA" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF8A8578" />

    <SolidColorBrush x:Key="PopoverBrush" Color="#FFFAF9F5" />
    <SolidColorBrush x:Key="TooltipBrush" Color="#FF1F1E1C" />

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFAF9F5" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFE8E6DC" />

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">10</CornerRadius>
    <CornerRadius x:Key="RadiusPill">3</CornerRadius>

    <!-- 形状 token：标准主题取值即 0.8.5 的现状；夹夹主题在 Palette.Jiajia.xaml 覆盖。
         控件模板只引用这些键（DynamicResource），不再按主题写死形状。 -->

    <!-- 历史行：标准 = 透明底 + 左缘 2px 选中条 + 发线分隔；夹夹 = 白卡片描边，无发线。 -->
    <CornerRadius x:Key="RowCornerRadius">6</CornerRadius>
    <Thickness x:Key="RowBorderThickness">2,0,0,0</Thickness>
    <Thickness x:Key="RowCardInset">0</Thickness>
    <SolidColorBrush x:Key="RowCardBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="RowBorderBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="RowSelectedBorderBrush" Color="#FFD97757" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#101F1E1C" />
    <SolidColorBrush x:Key="RowSelectedMetaBrush" Color="#FFA39F94" />
    <Visibility x:Key="RowSeparatorVisibility">Visible</Visibility>
    <!-- 全局列表项（文件夹栏等）的选中左缘条：标准 2px 赤陶；夹夹、Kami 为 0，只用同色底。 -->
    <Thickness x:Key="SelectionEdgeThickness">2,0,0,0</Thickness>
    <SolidColorBrush x:Key="SelectionEdgeBrush" Color="#FFD97757" />
    <!-- 选中行的偏移阴影、夹子与折角；只在夹夹主题显示，只加在历史、配置条目这类卡片行上。 -->
    <Visibility x:Key="SelectionDecorVisibility">Collapsed</Visibility>
    <SolidColorBrush x:Key="SelectionDecorBrush" Color="#FF1F1E1C" />
    <!-- 历史页空状态里的夹夹（还需"显示小宠物"开启）。 -->
    <Visibility x:Key="EmptyPetVisibility">Collapsed</Visibility>

    <!-- 顶部页签：标准 = 沙色圆角块 + 赤陶下划线 + 底部发线；夹夹 = 描边胶囊，无下划线。 -->
    <CornerRadius x:Key="NavPillRadius">6</CornerRadius>
    <Thickness x:Key="NavPillBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="NavPillBorderBrush" Color="#00FFFFFF" />
    <Thickness x:Key="NavBottomBorderThickness">0,0,0,1</Thickness>
    <SolidColorBrush x:Key="NavMarkBrush" Color="#FFD97757" />
    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#FFF0E9DE" />
    <SolidColorBrush x:Key="NavSelectedForegroundBrush" Color="#FFD97757" />

    <!-- 筛选条：标准 = 墨色下划线；夹夹 = 选中为填充胶囊。键盘焦点仍用下划线显示。 -->
    <CornerRadius x:Key="ChipCornerRadius">0</CornerRadius>
    <SolidColorBrush x:Key="ChipCheckedBackgroundBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ChipMarkBrush" Color="#FF1F1E1C" />

    <!-- 搜索框。 -->
    <CornerRadius x:Key="SearchCornerRadius">4</CornerRadius>
    <SolidColorBrush x:Key="SearchFillBrush" Color="#FFFAF9F5" />

    <!-- 主题文案：由主题提供，代码按键读取，不在窗口里散落硬编码。 -->
    <sys:String x:Key="CopyEmptyHistory">还没有历史，复制内容试试</sys:String>
    <sys:String x:Key="CopyPausedHistory">监听已暂停</sys:String>
    <sys:String x:Key="CopyNoResults">没有匹配的记录</sys:String>

    <Thickness x:Key="RowMarginRelaxed">12,8,12,8</Thickness>
    <Thickness x:Key="RowMarginCompact">12,5,12,5</Thickness>

    <DropShadowEffect x:Key="PopoverShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#FF000000" />

</ResourceDictionary>
