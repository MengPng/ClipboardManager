<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ClipboardManager</AssemblyName>
    <RootNamespace>ClipboardManager.Windows</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">false</PublishSingleFile>
    <!-- Both publish scripts must yield the same binary. The MSI script once omitted compression
         and shipped a 159 MB build while the portable EXE was 70 MB. -->
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">false</PublishReadyToRun>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <EmbeddedResource Include="Assets\Pet\*.png" />
    <!-- Kubai 主题图标（scripts/build-kubai-icons.ps1 生成）；pack URI 引用，其他主题不加载。 -->
    <Resource Include="Assets\Icons\Kubai\*.png" />
    <!-- 0.9.5：官方 Everything 安装程序（ADR-0007 附录），只在用户点击「安装 Everything」时解出运行。 -->
    <EmbeddedResource Include="Assets\Everything\Everything-1.4.1.1032.x64-Setup.exe" LogicalName="ClipboardManager.Embedded.EverythingSetup.exe" />
    <EmbeddedResource Include="$(MaintenanceHelperPath)" LogicalName="ClipboardManager.Embedded.Maintenance.exe" Condition="'$(MaintenanceHelperPath)' != '' and Exists('$(MaintenanceHelperPath)')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClipboardManager.Domain\ClipboardManager.Domain.csproj" />
    <ProjectReference Include="..\ClipboardManager.Application\ClipboardManager.Application.csproj" />
    <ProjectReference Include="..\ClipboardManager.Infrastructure\ClipboardManager.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
