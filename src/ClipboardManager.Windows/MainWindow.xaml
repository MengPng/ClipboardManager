<!--
    The window keeps no system frame: WindowChrome extends the DWM frame across the
    whole client area so the acrylic backdrop shows through, and the title bar below
    is ordinary content. AllowsTransparency is deliberately left off, because a
    layered window disables the backdrop this layout depends on.
-->
<Window x:Class="ClipboardManager.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪切板"
        Width="780" Height="580" MinWidth="560" MinHeight="420"
        Icon="Assets/AppIcon.ico"
        Style="{StaticResource AppWindowStyle}"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <WindowChrome.WindowChrome>
        <!-- CaptionHeight is zero so the header cannot be double-clicked into a
             maximised state; dragging is handled explicitly instead. -->
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- RootSurface is opaque-filled from code when the backdrop is unavailable. -->
    <Border x:Name="RootSurface" Background="{StaticResource WindowVibrancyBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Title bar  -->

            <Grid x:Name="TitleBar" Grid.Row="0" Height="46" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/ClipboardManager;component/Assets/AppIcon.ico"
                           Width="20" Height="20" VerticalAlignment="Center" Stretch="Uniform" />
                    <TextBlock Margin="9,0,0,0" Style="{StaticResource TitleTextStyle}" Text="剪切板" />
                    <Border Margin="9,0,0,0" Padding="7,2" Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="{StaticResource RadiusPill}" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource FontSizeMeta}" Text="本机" />
                    </Border>
                </StackPanel>

                <TextBlock x:Name="ListeningStatusText" Grid.Column="1" Margin="0,0,10,0"
                           VerticalAlignment="Center" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{StaticResource SuccessBrush}" Text="● 正在监听" />

                <!-- The content of these buttons is a private-use icon glyph, which is
                     meaningless to a screen reader, so each carries an explicit name. -->
                <StackPanel Grid.Column="2" Margin="0,0,8,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggleButtonStyle}"
                                  Click="PinButton_Click" Content="&#xE718;"
                                  AutomationProperties.Name="常驻前台" />
                    <ToggleButton x:Name="PauseButton" Style="{StaticResource IconToggleButtonStyle}"
                                  Click="PauseButton_Click" Content="&#xE769;"
                                  AutomationProperties.Name="暂停监听" />
                    <Button Style="{StaticResource IconButtonStyle}" Click="SettingsButton_Click"
                            Content="&#xE713;" ToolTip="设置" AutomationProperties.Name="设置" />
                    <Button Style="{StaticResource IconButtonStyle}" Click="CloseButton_Click"
                            Content="&#xE8BB;" ToolTip="隐藏面板（Esc）" AutomationProperties.Name="隐藏面板" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{StaticResource SeparatorBrush}" />

            <!--  Body  -->

            <!-- The nav strip and the two panels are siblings: 个人配置 and 团队配置 share a
                 single instance of the config UI and differ only in the target Workspace,
                 so the panel must not be rebuilt (or duplicated) per space. -->
            <Grid Grid.Row="1" Margin="10,8,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TabControl x:Name="MainTabs" Grid.Row="0" Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SegmentedTabControlStyle}"
                            SelectionChanged="MainTabs_SelectionChanged">
                    <TabItem Header="历史" Tag="&#xE81C;" />
                    <TabItem Header="个人配置" Tag="&#xE77B;" />
                    <TabItem x:Name="TeamSpaceTab" Header="团队配置" Tag="&#xE716;" />
                    <TabItem Header="局域网共享" Tag="&#xE968;" />
                </TabControl>

                <Grid x:Name="HistoryPanel" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}"
                                 Tag="搜索正文或来源应用" TextChanged="SearchBox_TextChanged" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Click="CollectSelectedButton_Click"
                                Content="存入配置" ToolTip="选择个人配置或团队配置中的文件夹，保存选中历史记录的快照" />
                    </Grid>

                    <!-- A WrapPanel rather than a StackPanel so the pills reflow instead of
                         being clipped at the window's minimum width. -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,3">
                        <RadioButton x:Name="AllFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" IsChecked="True"
                                     Click="AllFilterButton_Click" Content="全部" />
                        <RadioButton x:Name="PinnedFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="PinnedFilterButton_Click" Content="置顶" />
                        <RadioButton x:Name="TextFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="TextFilterButton_Click" Content="文本" />
                        <RadioButton x:Name="ImageFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="ImageFilterButton_Click" Content="图片" />
                        <RadioButton x:Name="FileFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="FileFilterButton_Click" Content="文件" />
                        <RadioButton x:Name="FavoriteFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="FavoriteFilterButton_Click" Content="快速收藏" />
                    </WrapPanel>

                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}">
                        <Grid>
                            <ListBox x:Name="HistoryList"
                                     ItemsSource="{Binding Items}"
                                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                     SelectionChanged="HistoryList_SelectionChanged"
                                     MouseDoubleClick="HistoryList_MouseDoubleClick"
                                     ContextMenuOpening="HistoryList_ContextMenuOpening">
                                <ListBox.ContextMenu>
                                    <ContextMenu />
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{Binding DataContext.RowMargin, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.RowSpan="2" Margin="0,0,10,0" VerticalAlignment="Top"
                                                    Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    Background="{StaticResource ThumbnailBackdropBrush}"
                                                    CornerRadius="{StaticResource RadiusSmall}"
                                                    Padding="{Binding PreviewPadding}"
                                                    Visibility="{Binding PreviewVisibility}">
                                                <Image Source="{Binding Preview}" Stretch="{Binding PreviewStretch}" />
                                            </Border>

                                            <TextBlock Grid.Column="1" Text="{Binding PreviewText}" TextWrapping="Wrap"
                                                       MaxHeight="{Binding DataContext.PreviewMaxHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />

                                            <StackPanel Grid.Column="2" Margin="8,0,0,0" Orientation="Horizontal" VerticalAlignment="Top">
                                                <TextBlock Margin="0,0,5,0" FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{StaticResource AccentBrush}" Text="{Binding PinnedMark}" />
                                                <TextBlock FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{StaticResource DangerBrush}" Text="{Binding FavoriteMark}" />
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5,0,0"
                                                       Style="{StaticResource MetaTextStyle}" Text="{Binding Metadata}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyStateText" Text="还没有历史，复制内容试试"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource LabelTertiaryBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="ConfigPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Shown only for 团队配置, because that space is a second local
                         container today and must not look like working team sharing. -->
                    <Border x:Name="ConfigSpaceNotice" Grid.Row="0" Margin="0,0,0,9" Padding="10,6"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="{StaticResource RadiusMedium}" Visibility="Collapsed">
                        <TextBlock Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Text="团队配置目前只保存在本机，尚未接入账号、云端或团队成员共享。" />
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLarge}">
                                <ListBox x:Name="FolderList"
                                         ItemsSource="{Binding Folders}"
                                         SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                                         SelectionChanged="FolderList_SelectionChanged"
                                         ContextMenuOpening="FolderList_ContextMenuOpening"
                                         PreviewMouseMove="FolderList_PreviewMouseMove"
                                         Drop="FolderList_Drop" AllowDrop="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="8,6">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MetaTextStyle}"
                                                           VerticalAlignment="Center" Text="{Binding CountText}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="9" HorizontalAlignment="Stretch" />

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CollectionSearchBox" Style="{StaticResource SearchTextBoxStyle}"
                                         Tag="搜索当前空间的配置" TextChanged="CollectionSearchBox_TextChanged" />
                                <StackPanel x:Name="PersonalTransferPanel" Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal">
                                    <Button Margin="0,0,6,0" Click="ExportPersonalConfigButton_Click" Content="导出" ToolTip="将个人配置及其图片、文件副本导出为迁移包" />
                                    <Button Click="ImportPersonalConfigButton_Click" Content="导入" ToolTip="从迁移包合并导入个人配置" />
                                </StackPanel>
                                <Button Grid.Column="2" Margin="8,0,0,0" Click="AddCollectionButton_Click" Content="添加" />
                            </Grid>

                            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLarge}">
                                <Grid>
                                <ListBox x:Name="CollectionList"
                                         ItemsSource="{Binding CollectionItems}"
                                         SelectedItem="{Binding SelectedCollectionItem, Mode=TwoWay}"
                                         AllowDrop="True"
                                         PreviewMouseMove="CollectionList_PreviewMouseMove"
                                         Drop="CollectionList_Drop"
                                         SelectionChanged="CollectionList_SelectionChanged"
                                         MouseDoubleClick="CollectionList_MouseDoubleClick"
                                         ContextMenuOpening="CollectionList_ContextMenuOpening">
                                    <ListBox.ContextMenu>
                                        <ContextMenu />
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="{Binding DataContext.RowMargin, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Margin="0,0,10,0" VerticalAlignment="Top"
                                                        Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        Background="{StaticResource ThumbnailBackdropBrush}"
                                                        CornerRadius="{StaticResource RadiusSmall}"
                                                        Padding="{Binding ThumbnailPadding}"
                                                        Visibility="{Binding ThumbnailVisibility}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="{Binding ThumbnailStretch}" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0" Text="{Binding Preview}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource LabelSecondaryBrush}"
                                                               MaxHeight="{Binding DataContext.PreviewMaxHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding TypeText}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="CollectionEmptyStateText" Text="这个文件夹还没有内容"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource LabelTertiaryBrush}" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="2" Margin="2,8,0,0" Style="{StaticResource MetaTextStyle}"
                                       Text="右键编辑 / 移动 / 上移下移 / 文件操作；Alt+↑ Alt+↓ 调整顺序，拖到左侧目录可移动" />
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="LanSharePanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,2,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="附近设备" />
                            <TextBlock x:Name="LanStatusText" Margin="0,3,0,0" Style="{StaticResource MetaTextStyle}"
                                       Text="点击刷新发现同一局域网内的 LocalSend 设备" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,7,0" Padding="12,6" Click="RefreshLanDevicesButton_Click" Content="刷新设备" />
                            <Button Padding="12,6" Click="OpenLanSettingsButton_Click" Content="共享设置" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}">
                        <Grid>
                            <ListBox x:Name="LanDeviceList" ItemsSource="{Binding LanDevices}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Alias}" />
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding Detail}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" Text="可发送" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="LanEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource LabelTertiaryBrush}" Text="尚未发现设备" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!--  Footer  -->

            <Border Grid.Row="2" Margin="0,10,0,0" Padding="16,9" Background="{StaticResource ChromeBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" Style="{StaticResource SecondaryTextStyle}" Text="0 条记录" />
                        <TextBlock x:Name="WorkspaceText" Margin="0,1,0,0" Style="{StaticResource MetaTextStyle}"
                                   Text="Workspace：初始化中" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource MetaTextStyle}"
                               Text="Enter 使用 · Del 删除 · Ctrl+D 存入个人配置 · Ctrl+P 置顶 · Alt+↑/↓ 排序 · Alt+V 呼出" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
