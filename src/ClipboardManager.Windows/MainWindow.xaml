<Window x:Class="ClipboardManager.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ClipboardManager.Windows.Services"
        Title="剪切板"
        Width="340" Height="540" MinWidth="340" MinHeight="450"
        Icon="Assets/AppIcon.ico"
        Style="{StaticResource AppWindowStyle}"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootSurface" Background="{StaticResource WindowSurfaceBrush}">
        <Grid x:Name="WindowLayoutRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="StatusRow" Height="Auto" />
                <RowDefinition x:Name="MainContentRow" Height="*" />
                <RowDefinition x:Name="FooterRow" Height="Auto" />
            </Grid.RowDefinitions>


            <Grid x:Name="TitleBar" Grid.Row="0" Height="32" Background="{StaticResource WindowChromeBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="12,0,4,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/ClipboardManager;component/Assets/AppIcon.ico"
                           Width="16" Height="16" VerticalAlignment="Center" Stretch="Uniform" />
                    <TextBlock x:Name="WindowTitleText" Margin="6,0,0,0" Style="{StaticResource TitleTextStyle}" Text="剪切板" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,6,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ListeningStatusText" Margin="0,0,4,0"
                               VerticalAlignment="Center" FontSize="{StaticResource FontSizeMeta}"
                               Foreground="{StaticResource SuccessBrush}" TextTrimming="CharacterEllipsis"
                               Text="● 监听" />
                    <ToggleButton x:Name="PauseButton" Width="24" Style="{StaticResource IconToggleButtonStyle}"
                                  Click="PauseButton_Click" Content="&#xE769;"
                                  ToolTip="暂停监听" AutomationProperties.Name="暂停监听" />
                    <ToggleButton x:Name="PinButton" Width="24" Style="{StaticResource IconToggleButtonStyle}"
                                  Click="PinButton_Click" Content="&#xE718;"
                                  ToolTip="常驻前台" AutomationProperties.Name="常驻前台" />
                    <Button x:Name="SettingsButton" Width="24" Style="{StaticResource IconButtonStyle}" Click="SettingsButton_Click"
                            Content="&#xE713;" ToolTip="设置" AutomationProperties.Name="设置" />
                    <Button x:Name="ExpandCollapseButton" Width="24" Style="{StaticResource IconButtonStyle}"
                            Click="ExpandCollapseButton_Click" Content="&#xE70E;"
                            ToolTip="收起为标题栏" AutomationProperties.Name="收起剪切板" />

                    <Button x:Name="CloseButton" Width="24" Style="{StaticResource IconButtonStyle}" Click="CloseButton_Click"
                            Content="&#xE8BB;" ToolTip="隐藏面板（Esc）" AutomationProperties.Name="隐藏面板" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{StaticResource SeparatorBrush}" />

            <Grid Grid.Row="2" Margin="12,8,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TabControl x:Name="MainTabs" Grid.Row="0" Margin="0,0,0,12"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource SegmentedTabControlStyle}"
                            SelectionChanged="MainTabs_SelectionChanged">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource SegmentedTabItemStyle}" />
                    </TabControl.ItemContainerStyle>
                    <TabItem x:Name="HistoryTab" Header="历史" Tag="&#xE81C;" />
                    <TabItem x:Name="PersonalSpaceTab" Header="配置" Tag="&#xE77B;" />
                    <TabItem x:Name="TodoTab" Header="待办" Tag="&#xE9D5;" />
                    <TabItem x:Name="CalculatorTab" Header="计算" Tag="&#xE8EF;" />
                    <TabItem x:Name="SelectionAiTab" Header="划词" Tag="&#xE8D4;" />
                    <TabItem x:Name="TeamSpaceTab" Header="团队" Tag="&#xE716;" Visibility="Collapsed" />
                    <TabItem x:Name="LanShareTab" Header="共享" Tag="&#xE968;" Visibility="Collapsed" />
                </TabControl>

                <Grid x:Name="HistoryPanel" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}"
                                 Tag="搜索正文或来源应用" TextChanged="SearchBox_TextChanged" />
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,12"
                               HorizontalAlignment="Left">
                        <RadioButton x:Name="AllFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" IsChecked="True"
                                     Click="AllFilterButton_Click" Content="全部" />
                        <RadioButton x:Name="PinnedFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="PinnedFilterButton_Click" Content="置顶"
                                     Visibility="Collapsed" />
                        <RadioButton x:Name="TextFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="TextFilterButton_Click" Content="文本" />
                        <RadioButton x:Name="ImageFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="ImageFilterButton_Click" Content="图片" />
                        <RadioButton x:Name="FileFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="FileFilterButton_Click" Content="文件" />
                        <RadioButton x:Name="FavoriteFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="FavoriteFilterButton_Click" Content="快速收藏"
                                     Visibility="Collapsed" />
                    </WrapPanel>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="HistoryList"
                                     ItemsSource="{Binding Items}"
                                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                     SelectionChanged="HistoryList_SelectionChanged"
                                     MouseDoubleClick="HistoryList_MouseDoubleClick"
                                     ContextMenuOpening="HistoryList_ContextMenuOpening">
                                <ListBox.ContextMenu>
                                    <ContextMenu />
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{Binding DataContext.RowMargin, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.RowSpan="2" Margin="0,1,8,0" VerticalAlignment="Top"
                                                    Width="32" Height="32"
                                                    Background="{StaticResource ThumbnailBackdropBrush}"
                                                    CornerRadius="{StaticResource RadiusSmall}"
                                                    Padding="0">
                                                <Grid>
                                                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFontFamily}"
                                                               Foreground="{StaticResource LabelSecondaryBrush}" FontSize="16"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PreviewVisibility}" Value="Collapsed">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding Preview}" Stretch="{Binding PreviewStretch}" />
                                                </Grid>
                                            </Border>

                                            <TextBlock Grid.Column="1" Text="{Binding PreviewText}" TextWrapping="{Binding PreviewWrapping}" TextTrimming="CharacterEllipsis"
                                                       MaxHeight="{Binding DataContext.PreviewMaxHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />

                                            <StackPanel Grid.Column="2" Margin="8,0,0,0" Orientation="Horizontal" VerticalAlignment="Top">
                                                <TextBlock Margin="0,0,5,0" FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{StaticResource AccentBrandBrush}" Text="{Binding PinnedMark}" />
                                                <TextBlock FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{StaticResource DangerBrush}" Text="{Binding FavoriteMark}" />
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                                       Style="{StaticResource MetaTextStyle}" Text="{Binding Metadata}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Row="2" Grid.ColumnSpan="3" Height="1" Margin="{Binding DataContext.HistorySeparatorMargin, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    Background="{StaticResource SeparatorBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyStateText" Text="还没有历史，复制内容试试"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource LabelTertiaryBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>

                <Grid x:Name="TodoPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition x:Name="TodoSideGapColumn" Width="0" />
                        <ColumnDefinition x:Name="TodoSideColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TodoDateText" VerticalAlignment="Center"
                                       Style="{StaticResource TitleTextStyle}" Text="待办" />
                        </Grid>
                        <WrapPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
                            <RadioButton x:Name="TodoAllStatsButton" IsChecked="True"
                                         Style="{StaticResource FilterChipStyle}" GroupName="TodoTopFilter"
                                         Click="TodoAllStatsButton_Click" Content="全部" />
                            <RadioButton x:Name="TodoActiveFilterButton" Style="{StaticResource FilterChipStyle}"
                                         GroupName="TodoTopFilter"
                                         Click="TodoActiveFilterButton_Click" Content="进行中" />
                            <RadioButton x:Name="TodoCompletedFilterButton" Style="{StaticResource FilterChipStyle}"
                                         GroupName="TodoTopFilter"
                                         Click="TodoCompletedFilterButton_Click" Content="已完成" />
                            <Border Width="1" Height="18" Margin="4,3,8,3" Background="{StaticResource SeparatorBrush}" />
                            <RadioButton x:Name="TodoMonthStatsButton"
                                         Style="{StaticResource FilterChipStyle}" GroupName="TodoTopFilter"
                                         Click="TodoMonthStatsButton_Click" Content="本月" />
                            <RadioButton x:Name="TodoYearStatsButton"
                                         Style="{StaticResource FilterChipStyle}" GroupName="TodoTopFilter"
                                         Click="TodoYearStatsButton_Click" Content="今年" />
                        </WrapPanel>
                        <TextBox x:Name="TodoSearchBox" Grid.Row="2" Margin="0,8,0,0"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Tag="搜索待办"
                                 TextChanged="TodoSearchBox_TextChanged" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,0,0,8" Padding="0"
                                Background="Transparent">
                            <Grid><UniformGrid x:Name="TodoSummaryCards" Columns="4">
                                <ToggleButton x:Name="TodoCompletedSummaryButton" Margin="2" Padding="5,6"
                                              AutomationProperties.Name="完成统计"
                                              ToolTip="查看当前范围内已完成待办；再次点击取消筛选"
                                              Style="{StaticResource TodoTagToggleStyle}"
                                              Click="TodoCompletedSummaryButton_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="TodoCompletedLabel" HorizontalAlignment="Center"
                                                   Style="{StaticResource MetaTextStyle}" Text="完成" />
                                        <TextBlock x:Name="TodoTodayCompletedText" HorizontalAlignment="Center"
                                                   FontSize="16" FontWeight="SemiBold" Text="0" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TodoPendingSummaryButton" Margin="2" Padding="5,6"
                                              AutomationProperties.Name="待完成统计"
                                              ToolTip="查看当前范围内待完成待办；再次点击取消筛选"
                                              Style="{StaticResource TodoTagToggleStyle}"
                                              Click="TodoPendingSummaryButton_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="TodoPendingLabel" HorizontalAlignment="Center"
                                                   Style="{StaticResource MetaTextStyle}" Text="待完成" />
                                        <TextBlock x:Name="TodoPendingText" HorizontalAlignment="Center"
                                                   FontSize="16" FontWeight="SemiBold" Text="0" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TodoCreatedSummaryButton" Margin="2" Padding="5,6"
                                              AutomationProperties.Name="新增统计"
                                              ToolTip="查看当前范围内新增待办；再次点击取消筛选"
                                              Style="{StaticResource TodoTagToggleStyle}"
                                              Click="TodoCreatedSummaryButton_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="TodoCreatedLabel" HorizontalAlignment="Center"
                                                   Style="{StaticResource MetaTextStyle}" Text="新增" />
                                        <TextBlock x:Name="TodoTodayCreatedText" HorizontalAlignment="Center"
                                                   FontSize="16" FontWeight="SemiBold" Text="0" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TodoRateSummaryButton" Margin="2" Padding="5,6"
                                              AutomationProperties.Name="完成率统计"
                                              ToolTip="查看当前范围内用于计算完成率的待办；再次点击取消筛选"
                                              Style="{StaticResource TodoTagToggleStyle}"
                                              Click="TodoRateSummaryButton_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="TodoRateLabel" HorizontalAlignment="Center"
                                                   Style="{StaticResource MetaTextStyle}" Text="完成率" />
                                        <TextBlock x:Name="TodoCompletionRateText" HorizontalAlignment="Center"
                                                   FontSize="16" FontWeight="SemiBold" Text="0%" />
                                    </StackPanel>
                                </ToggleButton>
                            </UniformGrid>
<Grid IsHitTestVisible="False">
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Line Grid.ColumnSpan="4" X2="1" Stretch="Fill" Height="1" VerticalAlignment="Top" Stroke="{StaticResource BorderStrongBrush}" StrokeDashArray="3,3" />
<Line Grid.ColumnSpan="4" X2="1" Stretch="Fill" Height="1" VerticalAlignment="Bottom" Stroke="{StaticResource BorderStrongBrush}" StrokeDashArray="3,3" />
<Line Grid.Column="0" Y2="1" Stretch="Fill" Width="1" HorizontalAlignment="Right" Stroke="{StaticResource BorderStrongBrush}" StrokeDashArray="3,3" />
<Line Grid.Column="1" Y2="1" Stretch="Fill" Width="1" HorizontalAlignment="Right" Stroke="{StaticResource BorderStrongBrush}" StrokeDashArray="3,3" />
<Line Grid.Column="2" Y2="1" Stretch="Fill" Width="1" HorizontalAlignment="Right" Stroke="{StaticResource BorderStrongBrush}" StrokeDashArray="3,3" />
</Grid></Grid>
</Border>

                        <Grid Grid.Row="1" Height="0" />

                        <DockPanel Grid.Row="2" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Left" Margin="0,0,6,6" Padding="9,3" FontSize="13" Click="ExportTodoDetailsButton_Click" Content="导出明细" ToolTip="导出全部待办及标签明细" />
                            <ItemsControl ItemsSource="{Binding TodoTagChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton FontSize="13" Style="{StaticResource TodoTagToggleStyle}"
                                                      Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Click="TodoTagChoice_Click"
                                                      MouseRightButtonUp="TodoTagChoice_MouseRightButtonUp"
                                                      ToolTip="{Binding ToolTipText}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <Grid Grid.Row="3">
                            <ListBox x:Name="TodoList"
                                         ItemsSource="{Binding TodoItems}"
                                         SelectedItem="{Binding SelectedTodoItem, Mode=TwoWay}"
                                         PreviewMouseLeftButtonUp="TodoList_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="7,4" MouseRightButtonUp="TodoItem_MouseRightButtonUp">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource TodoCircleCheckBoxStyle}"
                                                          Width="18" Height="18" FontSize="10"
                                                          IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                          Background="{Binding CheckBrush}"
                                                          BorderBrush="{Binding CheckBrush}"
                                                          Foreground="White"
                                                          Click="TodoCompletedCheckBox_Click"
                                                          VerticalAlignment="Top" Margin="0,1,8,0" />
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Margin="0,0,6,2" VerticalAlignment="Center"
                                                               Text="{Binding OverdueText}"
                                                               Foreground="{StaticResource DangerBrush}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Visibility="{Binding OverdueVisibility}" />
                                                    <TextBlock Margin="0,0,0,2" VerticalAlignment="Center"
                                                               Text="{Binding Title}" TextWrapping="Wrap"
                                                               TextDecorations="{Binding TitleDecorations}"
                                                               Foreground="{Binding TitleBrush}" />
                                                </WrapPanel>

                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="TodoEmptyStateText" Text="还没有待办，请在下方添加一条"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource LabelTertiaryBrush}" IsHitTestVisible="False" />
                            </Grid>

                        <Grid Grid.Row="4" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TodoTitleBox" Style="{StaticResource SearchTextBoxStyle}"
                                     Tag="添加待办，回车即可"
                                     KeyDown="TodoTitleBox_KeyDown" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,6"
                                    Click="AddTodoButton_Click" Content="添加" />
                        </Grid>


                    </Grid>


                </Grid>

                <Grid x:Name="ConfigPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="ConfigSpaceNotice" Grid.Row="0" Margin="0,0,0,9" Padding="10,6"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="{StaticResource RadiusMedium}" Visibility="Collapsed">
                        <TextBlock Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Text="本地团队配置仅保存在本机；切换云端后显示当前云团队的本地镜像。" />
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.32*" MinWidth="96" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <ListBox x:Name="FolderList"
                                         ItemsSource="{Binding Folders}"
                                         SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                                         SelectionChanged="FolderList_SelectionChanged"
                                         ContextMenuOpening="FolderList_ContextMenuOpening"
                                         PreviewMouseMove="FolderList_PreviewMouseMove"
                                         Drop="FolderList_Drop" AllowDrop="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="8,6">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MetaTextStyle}"
                                                           VerticalAlignment="Center" Text="{Binding CountText}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="9" HorizontalAlignment="Stretch" />

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,9">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="CollectionSearchBox" Style="{StaticResource SearchTextBoxStyle}"
                                         Tag="搜索当前空间的配置" TextChanged="CollectionSearchBox_TextChanged" />
                                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                    <StackPanel x:Name="PersonalTransferPanel" Orientation="Horizontal">
                                        <Button Margin="0,0,6,0" Padding="8,4" Click="ExportPersonalConfigButton_Click" Content="导出" ToolTip="将个人配置及其图片、文件副本导出为迁移包" />
                                        <Button Margin="0,0,6,0" Padding="8,4" Click="ImportPersonalConfigButton_Click" Content="导入" ToolTip="从迁移包合并导入个人配置" />
                                    </StackPanel>
                                    <Button Padding="8,4" Click="AddCollectionButton_Click" Content="添加" />
                                </WrapPanel>
                            </Grid>
                            <Grid Grid.Row="1">
                                <ListBox x:Name="CollectionList"
                                         ItemsSource="{Binding CollectionItems}"
                                         SelectedItem="{Binding SelectedCollectionItem, Mode=TwoWay}"
                                         AllowDrop="True"
                                         PreviewMouseMove="CollectionList_PreviewMouseMove"
                                         Drop="CollectionList_Drop"
                                         SelectionChanged="CollectionList_SelectionChanged"
                                         MouseDoubleClick="CollectionList_MouseDoubleClick"
                                         ContextMenuOpening="CollectionList_ContextMenuOpening">
                                    <ListBox.ContextMenu>
                                        <ContextMenu />
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="{Binding DataContext.RowMargin, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Margin="0,0,10,0" VerticalAlignment="Top"
                                                        Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        Background="{StaticResource ThumbnailBackdropBrush}"
                                                        CornerRadius="{StaticResource RadiusSmall}"
                                                        Padding="{Binding ThumbnailPadding}"
                                                        Visibility="{Binding ThumbnailVisibility}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="{Binding ThumbnailStretch}" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0" Text="{Binding Preview}"
                                                               Foreground="{StaticResource LabelSecondaryBrush}"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding PreviewVisibility}" />
                                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding TypeText}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="CollectionEmptyStateText" Text="这个文件夹还没有内容"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource LabelTertiaryBrush}" IsHitTestVisible="False" />
                            </Grid>

                            
                        </Grid>
                    </Grid>

                </Grid>

                <ScrollViewer x:Name="CalculatorPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <CheckBox x:Name="ClipboardCalculatorCheckBox" Content="自动计算剪切板算式"
                                  Click="ClipboardCalculatorCheckBox_Click" />
                        <TextBlock Margin="0,5,0,8" TextWrapping="Wrap" Style="{StaticResource MetaTextStyle}"
                                   Text="开启后，复制 1+1 将变为 1+1=2。仅处理单行纯算式；暂停和应用排除仍生效。" />
                        <TextBox x:Name="CalculatorExpressionBox" MaxLength="512" MinHeight="36"
                                 ToolTip="输入算式，例如 (1250+380)/3，按 Enter 计算"
                                 AutomationProperties.Name="计算算式" KeyDown="CalculatorExpressionBox_KeyDown"
                                 TextChanged="CalculatorExpressionBox_TextChanged" />
                        <TextBox x:Name="CalculatorResultBox" Margin="0,7,0,0" IsReadOnly="True"
                                 FontSize="20" Text="输入算式后按 Enter" AutomationProperties.Name="计算结果" />
                        <TextBlock x:Name="CalculatorErrorText" Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="计算" Click="CalculateButton_Click" Margin="0,0,5,5" Padding="10,5" />
                            <Button x:Name="CopyCalculatorValueButton" Content="复制结果" IsEnabled="False"
                                    Click="CopyCalculatorValueButton_Click" Margin="0,0,5,5" Padding="10,5" />
                            <Button x:Name="CopyCalculatorEquationButton" Content="复制算式与结果" IsEnabled="False"
                                    Click="CopyCalculatorEquationButton_Click" Margin="0,0,0,5" Padding="10,5" />
                        </WrapPanel>
                    </StackPanel>
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">
                        <Button Content="7" Click="CalculatorKey_Click" /><Button Content="8" Click="CalculatorKey_Click" />
                        <Button Content="9" Click="CalculatorKey_Click" /><Button Content="÷" Click="CalculatorKey_Click" />
                        <Button Content="4" Click="CalculatorKey_Click" /><Button Content="5" Click="CalculatorKey_Click" />
                        <Button Content="6" Click="CalculatorKey_Click" /><Button Content="×" Click="CalculatorKey_Click" />
                        <Button Content="1" Click="CalculatorKey_Click" /><Button Content="2" Click="CalculatorKey_Click" />
                        <Button Content="3" Click="CalculatorKey_Click" /><Button Content="−" Click="CalculatorKey_Click" />
                        <Button Content="0" Click="CalculatorKey_Click" /><Button Content="." Click="CalculatorKey_Click" />
                        <Button Content="(" Click="CalculatorKey_Click" /><Button Content=")" Click="CalculatorKey_Click" />
                        <Button Content="清空" Click="CalculatorKey_Click" /><Button Content="退格" Click="CalculatorKey_Click" />
                        <Button Content="=" Click="CalculatorKey_Click" /><Button Content="+" Click="CalculatorKey_Click" />
                    </UniformGrid>
                    <Grid Grid.Row="2">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,6">
        <Button Content="清空记录" DockPanel.Dock="Right" HorizontalAlignment="Right"
                Click="ClearCalculationsButton_Click" Padding="8,4" />
        <TextBlock Text="最近计算（本次运行）" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
    </DockPanel>
    <Border Grid.Row="1" Height="1" Margin="0,0,0,6"
            Background="{StaticResource BorderStrongBrush}" Opacity="0.55" />
    <Grid Grid.Row="2" MinHeight="90" MaxHeight="180">
        <ListBox ItemsSource="{Binding Calculations}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="6,5,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding ResultText}" FontSize="18" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Margin="0,2,0,0" Text="{Binding Expression}"
                                   Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis" />
                        <WrapPanel Grid.Row="2" Margin="0,5,0,5">
                            <Button Content="复用" Click="ReuseCalculation_Click" Margin="0,0,4,0" Padding="6,3" />
                            <Button Content="复制原算式" Click="CopyOriginalCalculation_Click" Margin="0,0,4,0" Padding="6,3" />
                            <Button Content="复制结果" Click="CopyRecentCalculation_Click" Margin="0,0,4,0" Padding="6,3" />
                            <Button Content="删除" Click="DeleteCalculation_Click" Padding="6,3" />
                        </WrapPanel>
                        <Border Grid.Row="3" Height="1" Background="{StaticResource SeparatorBrush}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="CalculationEmptyText" Text="还没有计算记录" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource LabelTertiaryBrush}" />
    </Grid>
</Grid>
                  </Grid>
                </ScrollViewer>

                <Grid x:Name="SelectionAiPanel" Grid.Row="1" Visibility="Collapsed">
                    <ContentControl x:Name="SelectionAiSettingsHost" />
                </Grid>

                <Grid x:Name="LanSharePanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,2,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="附近设备" />
                            <TextBlock x:Name="LanStatusText" Margin="0,3,0,0" Style="{StaticResource MetaTextStyle}"
                                       Text="点击刷新发现同一局域网内的 LocalSend 设备" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,7,0" Padding="12,6" Click="RefreshLanDevicesButton_Click" Content="刷新设备" />
                            <Button Padding="12,6" Click="OpenLanSettingsButton_Click" Content="共享设置" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                            <ListBox x:Name="LanDeviceList" ItemsSource="{Binding LanDevices}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Alias}" />
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding Detail}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" Text="可发送" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="LanEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource LabelTertiaryBrush}" Text="尚未发现设备" IsHitTestVisible="False" />
                    </Grid>
                </Grid>

            </Grid>

            <Border Grid.Row="3" Margin="0,4,0,0" Padding="10,6" Background="{StaticResource ChromeBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
                <Grid x:Name="FooterContentGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock x:Name="CountText" Style="{StaticResource SecondaryTextStyle}" Text="0 条记录" />
                    </StackPanel>
                    <TextBlock x:Name="ShortcutHintText" Grid.Column="2" Margin="0,0,0,0"
                               Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center"
                               Text="Enter 使用" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

