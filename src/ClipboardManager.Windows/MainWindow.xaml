<Window x:Class="ClipboardManager.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ClipboardManager.Windows.Services"
        Title="剪切板"
        Width="340" Height="540" MinWidth="340" MinHeight="450"
        Icon="Assets/AppIcon.ico"
        Style="{StaticResource AppWindowStyle}"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootSurface" Background="{DynamicResource WindowSurfaceBrush}">
        <Grid x:Name="WindowLayoutRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="StatusRow" Height="Auto" />
                <RowDefinition x:Name="MainContentRow" Height="*" />
                <RowDefinition x:Name="FooterRow" Height="Auto" />
            </Grid.RowDefinitions>


            <Grid x:Name="TitleBar" Grid.Row="0" Height="32" Background="{DynamicResource WindowChromeBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="TitleLeftPanel" Margin="12,0,4,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="WindowTitleIcon" Source="pack://application:,,,/ClipboardManager;component/Assets/AppIcon.ico"
                           Width="16" Height="16" VerticalAlignment="Center" Stretch="Uniform" />
                    <TextBlock x:Name="WindowTitleText" Margin="6,0,0,0" Style="{StaticResource TitleTextStyle}" Text="剪切板" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,6,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ListeningStatusText" Margin="0,0,4,0"
                               VerticalAlignment="Center" FontSize="{DynamicResource FontSizeMeta}"
                               Foreground="{DynamicResource SuccessBrush}" TextTrimming="CharacterEllipsis"
                               Text="● 监听" />
                    <ToggleButton x:Name="PauseButton" Width="24" Style="{StaticResource IconToggleButtonStyle}"
                                  Click="PauseButton_Click" Content="&#xE769;"
                                  ToolTip="暂停监听" AutomationProperties.Name="暂停监听" />
                    <ToggleButton x:Name="PinButton" Width="24" Style="{StaticResource IconToggleButtonStyle}"
                                  Click="PinButton_Click" Content="&#xE718;"
                                  ToolTip="常驻前台" AutomationProperties.Name="常驻前台" />
                    <Button x:Name="SettingsButton" Width="24" Style="{StaticResource IconButtonStyle}" Click="SettingsButton_Click"
                            Content="&#xE713;" ToolTip="设置" AutomationProperties.Name="设置" />
                    <Button x:Name="ExpandCollapseButton" Width="24" Style="{StaticResource IconButtonStyle}"
                            Click="ExpandCollapseButton_Click" Content="&#xE70E;"
                            ToolTip="收起为标题栏" AutomationProperties.Name="收起剪切板" />

                    <Button x:Name="CloseButton" Width="24" Style="{StaticResource IconButtonStyle}" Click="CloseButton_Click"
                            Content="&#xE8BB;" ToolTip="隐藏面板（Esc）" AutomationProperties.Name="隐藏面板" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource SeparatorBrush}" />

            <Grid Grid.Row="2" Margin="12,8,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TabControl x:Name="MainTabs" Grid.Row="0" Margin="0,0,0,12"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource SegmentedTabControlStyle}"
                            SelectionChanged="MainTabs_SelectionChanged">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource SegmentedTabItemStyle}" />
                    </TabControl.ItemContainerStyle>
                    <TabItem x:Name="HistoryTab" Header="历史" Tag="&#xE81C;" />
                    <TabItem x:Name="PersonalSpaceTab" Header="配置" Tag="&#xE77B;" />
                    <TabItem x:Name="TodoTab" Header="待办" Tag="&#xE9D5;" />
                    <TabItem x:Name="CalculatorTab" Header="计算" Tag="&#xE8EF;" />
                    <TabItem x:Name="TeamSpaceTab" Header="团队" Tag="&#xE716;" Visibility="Collapsed" />
                    <TabItem x:Name="ShareTab" Header="共享" Tag="&#xE968;" />
                </TabControl>

                <Grid x:Name="HistoryPanel" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}"
                                 Tag="搜索正文或来源应用" TextChanged="SearchBox_TextChanged" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 筛选胶囊居中；条数放在右侧列，左右两列等宽，保证胶囊真正居中。 -->
                    <TextBlock x:Name="HistoryCountText" Grid.Column="2" Margin="8,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource MetaTextStyle}" Text="0 条" />
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Center">
                        <RadioButton x:Name="AllFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" IsChecked="True"
                                     Click="AllFilterButton_Click" Content="全部" />
                        <RadioButton x:Name="PinnedFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="PinnedFilterButton_Click" Content="置顶"
                                     Visibility="Collapsed" />
                        <RadioButton x:Name="TextFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="TextFilterButton_Click" Content="文本" />
                        <RadioButton x:Name="LinkFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="LinkFilterButton_Click" Content="链接" />
                        <RadioButton x:Name="ImageFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="ImageFilterButton_Click" Content="图片" />
                        <RadioButton x:Name="FileFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="FileFilterButton_Click" Content="文件" />
                        <RadioButton x:Name="FavoriteFilterButton" Style="{StaticResource FilterChipStyle}"
                                     GroupName="HistoryFilter" Click="FavoriteFilterButton_Click" Content="快速收藏"
                                     Visibility="Collapsed" />
                    </WrapPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="HistoryList"
                                     ItemsSource="{Binding Items}"
                                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource HistoryRowItemStyle}"
                                     SelectionChanged="HistoryList_SelectionChanged"
                                     MouseDoubleClick="HistoryList_MouseDoubleClick"
                                     ContextMenuOpening="HistoryList_ContextMenuOpening">
                                <ListBox.ContextMenu>
                                    <ContextMenu />
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{Binding DataContext.HistoryRowPadding, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 类型图标：文本 Aa、链接图标、文件扩展名徽标；图片与其它文件用缩略图/系统图标。仅显示层判断。 -->
                                            <Border Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Width="{Binding DataContext.HistoryIconSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    Height="{Binding DataContext.HistoryIconSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    Background="{DynamicResource ThumbnailBackdropBrush}"
                                                    CornerRadius="{DynamicResource RadiusSmall}"
                                                    Padding="0">
                                                <Grid>
                                                    <TextBlock Text="{Binding IconText}" FontFamily="{Binding IconFontFamily}"
                                                               FontSize="{Binding IconFontSize}" FontWeight="{Binding IconFontWeight}"
                                                               Foreground="{DynamicResource LabelSecondaryBrush}"
                                                               Visibility="{Binding IconVisibility}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <Image Source="{Binding Preview}" Stretch="{Binding PreviewStretch}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PreviewText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0" Text="{Binding Metadata}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MetaTextStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource RowSelectedMetaBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="8,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- 仅提示模式：短单行算式在行尾显示 = 结果；显示时计算，不入库，不改剪切板。 -->
                                                <Border Margin="0,0,6,0" Padding="8,1" MaxWidth="132" VerticalAlignment="Center"
                                                        Visibility="{Binding CalculationHintVisibility}" ToolTip="{Binding CalculationHintToolTip}"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource RadiusPill}">
                                                    <TextBlock Text="{Binding CalculationHintText}" TextTrimming="CharacterEllipsis"
                                                               FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                                                               Typography.NumeralAlignment="Tabular"
                                                               Foreground="{DynamicResource LabelPrimaryBrush}" />
                                                </Border>
                                                <TextBlock Margin="0,0,5,0" FontFamily="{DynamicResource IconFontFamily}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           Foreground="{DynamicResource AccentBrandBrush}" Text="{Binding PinnedMark}" />
                                                <TextBlock FontFamily="{DynamicResource IconFontFamily}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           Foreground="{DynamicResource DangerBrush}" Text="{Binding FavoriteMark}" />
                                            </StackPanel>

                                            <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                                                    Visibility="{DynamicResource RowSeparatorVisibility}"
                                                    Background="{DynamicResource SeparatorBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- 空状态：夹夹（PetCompanion 112×80，2 倍整数）在代码里插入到本面板，文案由主题提供（Copy* 键）。 -->
                            <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False" Visibility="Collapsed">
                                <Grid x:Name="EmptyPetHost" Width="112" Height="80" Margin="0,0,0,12" />
                                <TextBlock x:Name="EmptyStateText" Text="还没有历史，复制内容试试" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="260"
                                           Foreground="{DynamicResource LabelSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                <Grid x:Name="TodoPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition x:Name="TodoSideGapColumn" Width="0" />
                        <ColumnDefinition x:Name="TodoSideColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TodoDateText" VerticalAlignment="Center"
                                       Style="{StaticResource TitleTextStyle}" Text="待办" />
                        </Grid>
                        <WrapPanel Grid.Row="1" Margin="0" VerticalAlignment="Center">
                            <RadioButton x:Name="TodoAllStatsButton" IsChecked="True"
                                         Style="{StaticResource FilterChipStyle}" GroupName="TodoTopFilter"
                                         Click="TodoAllStatsButton_Click" Content="全部" />
                            <RadioButton x:Name="TodoActiveFilterButton" Style="{StaticResource FilterChipStyle}"
                                         GroupName="TodoTopFilter"
                                         Click="TodoActiveFilterButton_Click" Content="进行中" />
                            <RadioButton x:Name="TodoCompletedFilterButton" Style="{StaticResource FilterChipStyle}"
                                         GroupName="TodoTopFilter"
                                         Click="TodoCompletedFilterButton_Click" Content="已完成" />
                            <Border Width="1" Height="18" Margin="4,3,8,3" Background="{DynamicResource SeparatorBrush}" />
                            <RadioButton x:Name="TodoMonthStatsButton"
                                         Style="{StaticResource FilterChipStyle}" GroupName="TodoTopFilter"
                                         Click="TodoMonthStatsButton_Click" Content="本月" />
                            <RadioButton x:Name="TodoYearStatsButton"
                                         Style="{StaticResource FilterChipStyle}" GroupName="TodoTopFilter"
                                         Click="TodoYearStatsButton_Click" Content="今年" />
                        </WrapPanel>
                        <TextBox x:Name="TodoSearchBox" Grid.Row="2" Margin="0,8,0,0"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Tag="搜索待办"
                                 TextChanged="TodoSearchBox_TextChanged" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 统计：一行小胶囊，点击下钻、再次点击取消筛选（逻辑不变）；"导出明细"紧随"完成率"之后。
                             四枚胶囊与"导出明细"同在一个换行面板里，常规数值下一排放下，极端数值才折行，不裁切。 -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <WrapPanel x:Name="TodoSummaryCards" VerticalAlignment="Center">
                                <ToggleButton x:Name="TodoCompletedSummaryButton"
                                              AutomationProperties.Name="完成统计"
                                              ToolTip="查看当前范围内已完成待办；再次点击取消筛选"
                                              Style="{StaticResource TodoStatPillStyle}"
                                              Click="TodoCompletedSummaryButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TodoCompletedLabel" Text="完成" />
                                        <TextBlock x:Name="TodoTodayCompletedText" Margin="4,0,0,0" FontWeight="SemiBold" Text="0" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TodoPendingSummaryButton"
                                              AutomationProperties.Name="待完成统计"
                                              ToolTip="查看当前范围内待完成待办；再次点击取消筛选"
                                              Style="{StaticResource TodoStatPillStyle}"
                                              Click="TodoPendingSummaryButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TodoPendingLabel" Text="待完成" />
                                        <TextBlock x:Name="TodoPendingText" Margin="4,0,0,0" FontWeight="SemiBold" Text="0" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TodoCreatedSummaryButton"
                                              AutomationProperties.Name="新增统计"
                                              ToolTip="查看当前范围内新增待办；再次点击取消筛选"
                                              Style="{StaticResource TodoStatPillStyle}"
                                              Click="TodoCreatedSummaryButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TodoCreatedLabel" Text="新增" />
                                        <TextBlock x:Name="TodoTodayCreatedText" Margin="4,0,0,0" FontWeight="SemiBold" Text="0" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TodoRateSummaryButton"
                                              AutomationProperties.Name="完成率统计"
                                              ToolTip="查看当前范围内用于计算完成率的待办；再次点击取消筛选"
                                              Style="{StaticResource TodoStatPillStyle}"
                                              Click="TodoRateSummaryButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TodoRateLabel" Text="完成率" />
                                        <TextBlock x:Name="TodoCompletionRateText" Margin="4,0,0,0" FontWeight="SemiBold" Text="0%" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button x:Name="TodoExportDetailsButton" Margin="0,0,0,4" Padding="6,2" MinHeight="0"
                                        FontSize="{DynamicResource FontSizeMeta}"
                                    Click="ExportTodoDetailsButton_Click" Content="导出明细"
                                    ToolTip="导出全部待办及标签明细" AutomationProperties.Name="导出明细" />
                            </WrapPanel>
                        </Grid>

                        <Grid Grid.Row="1" Height="0" />

                        <DockPanel Grid.Row="2" Margin="0,0,0,6">
                            <ItemsControl ItemsSource="{Binding TodoTagChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton FontSize="13" Style="{StaticResource TodoTagToggleStyle}"
                                                      Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Click="TodoTagChoice_Click"
                                                      MouseRightButtonUp="TodoTagChoice_MouseRightButtonUp"
                                                      ToolTip="{Binding ToolTipText}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <Grid Grid.Row="3">
                            <ListBox x:Name="TodoList"
                                         ItemsSource="{Binding TodoItems}"
                                         SelectedItem="{Binding SelectedTodoItem, Mode=TwoWay}"
                                         PreviewMouseLeftButtonUp="TodoList_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="7,4" MouseRightButtonUp="TodoItem_MouseRightButtonUp">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource TodoCircleCheckBoxStyle}"
                                                          Width="18" Height="18" FontSize="10"
                                                          IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                          Background="{Binding CheckBrush}"
                                                          BorderBrush="{Binding CheckBrush}"
                                                          Foreground="White"
                                                          Click="TodoCompletedCheckBox_Click"
                                                          VerticalAlignment="Top" Margin="0,1,8,0" />
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Margin="0,0,6,2" VerticalAlignment="Center"
                                                               Text="{Binding OverdueText}"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Visibility="{Binding OverdueVisibility}" />
                                                    <TextBlock Margin="0,0,0,2" VerticalAlignment="Center"
                                                               Text="{Binding Title}" TextWrapping="Wrap"
                                                               TextDecorations="{Binding TitleDecorations}"
                                                               Foreground="{Binding TitleBrush}" />
                                                </WrapPanel>

                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="TodoEmptyStateText" Text="还没有待办，请在下方添加一条"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource LabelTertiaryBrush}" IsHitTestVisible="False" />
                            </Grid>

                        <Grid Grid.Row="4" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TodoTitleBox" Style="{StaticResource SearchTextBoxStyle}"
                                     Tag="添加待办，回车即可"
                                     KeyDown="TodoTitleBox_KeyDown" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,6"
                                    Click="AddTodoButton_Click" Content="添加" />
                        </Grid>


                    </Grid>


                </Grid>

                <Grid x:Name="ConfigPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="ConfigSpaceNotice" Grid.Row="0" Margin="0,0,0,9" Padding="10,6"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="{DynamicResource RadiusMedium}" Visibility="Collapsed">
                        <TextBlock Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Text="本地团队配置仅保存在本机；切换云端后显示当前云团队的本地镜像。" />
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.32*" MinWidth="96" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <ListBox x:Name="FolderList"
                                         ItemsSource="{Binding Folders}"
                                         SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                                         SelectionChanged="FolderList_SelectionChanged"
                                         ContextMenuOpening="FolderList_ContextMenuOpening"
                                         PreviewMouseMove="FolderList_PreviewMouseMove"
                                         Drop="FolderList_Drop" AllowDrop="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="8,6">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MetaTextStyle}"
                                                           VerticalAlignment="Center" Text="{Binding CountText}" />
                                                <TextBlock DockPanel.Dock="Right" Margin="6,0" Style="{StaticResource MetaTextStyle}"
                                                           VerticalAlignment="Center" Text="订阅" ToolTip="订阅得到的文件夹，内容只读"
                                                           Visibility="{Binding ManagedMarkVisibility}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="9" HorizontalAlignment="Stretch" />

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,9">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="CollectionSearchBox" Style="{StaticResource SearchTextBoxStyle}"
                                         Tag="搜索当前空间的配置" TextChanged="CollectionSearchBox_TextChanged" />
                                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                    <StackPanel x:Name="PersonalTransferPanel" Orientation="Horizontal">
                                        <Button Margin="0,0,6,0" Padding="8,4" Click="ExportPersonalConfigButton_Click" Content="导出" ToolTip="将个人配置及其图片、文件副本导出为迁移包" />
                                        <Button Margin="0,0,6,0" Padding="8,4" Click="ImportPersonalConfigButton_Click" Content="导入" ToolTip="从迁移包合并导入个人配置" />
                                    </StackPanel>
                                    <Button Padding="8,4" Click="AddCollectionButton_Click" Content="添加" />
                                </WrapPanel>
                            </Grid>
                            <Grid Grid.Row="1">
                                <ListBox x:Name="CollectionList"
                                         ItemsSource="{Binding CollectionItems}"
                                         SelectedItem="{Binding SelectedCollectionItem, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource CardRowItemStyle}"
                                         AllowDrop="True"
                                         PreviewMouseMove="CollectionList_PreviewMouseMove"
                                         Drop="CollectionList_Drop"
                                         SelectionChanged="CollectionList_SelectionChanged"
                                         MouseDoubleClick="CollectionList_MouseDoubleClick"
                                         ContextMenuOpening="CollectionList_ContextMenuOpening">
                                    <ListBox.ContextMenu>
                                        <ContextMenu />
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="{Binding DataContext.RowMargin, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Margin="0,0,10,0" VerticalAlignment="Top"
                                                        Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        Background="{DynamicResource ThumbnailBackdropBrush}"
                                                        CornerRadius="{DynamicResource RadiusSmall}"
                                                        Padding="{Binding ThumbnailPadding}"
                                                        Visibility="{Binding ThumbnailVisibility}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="{Binding ThumbnailStretch}" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0" Text="{Binding Preview}"
                                                               Foreground="{DynamicResource LabelSecondaryBrush}"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding PreviewVisibility}" />
                                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource MetaTextStyle}" Text="{Binding MetaText}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="CollectionEmptyStateText" Text="这个文件夹还没有内容"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource LabelTertiaryBrush}" IsHitTestVisible="False" />
                            </Grid>

                            
                        </Grid>
                    </Grid>

                </Grid>

                <Grid x:Name="CalculatorPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="0" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 剪切板里的算式怎么处理：关闭 / 仅提示结果（默认，不改写剪切板）/ 直接改写（旧行为）。 -->
                    <Grid Margin="2,0,2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="剪切板里的算式：" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
                        <ComboBox x:Name="ClipboardCalculatorModeBox" Grid.Column="1" MinHeight="26" Padding="8,2"
                                  AutomationProperties.Name="剪切板算式模式"
                                  ToolTip="仅提示结果：历史里在算式行尾显示 = 结果，不改写剪切板；直接改写：复制 1+1 变为 1+1=2"
                                  SelectionChanged="ClipboardCalculatorModeBox_SelectionChanged">
                            <ComboBoxItem Content="关闭" Tag="Off" />
                            <ComboBoxItem Content="仅提示结果" Tag="Hint" />
                            <ComboBoxItem Content="直接改写" Tag="Rewrite" />
                        </ComboBox>
                        <TextBlock x:Name="CalculatorTapeCountText" Grid.Column="2" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
                    </Grid>

                    <!-- 纸带：最近 30 条，只在内存里；最新一条紧贴输入框。点行复用，悬停显示 复制 / 复用 / 删除；键盘用 Enter 复用、Delete 删除，右键菜单同样可用。 -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="CalculatorTapeList" ItemsSource="{Binding Calculations}"
                                 VerticalAlignment="Bottom" Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource TapeRowItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="计算纸带"
                                 MouseLeftButtonUp="CalculatorTape_MouseLeftButtonUp"
                                 KeyDown="CalculatorTape_KeyDown"
                                 ContextMenuOpening="CalculatorTape_ContextMenuOpening">
                            <ListBox.ContextMenu>
                                <ContextMenu />
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Expression}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource LabelSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Expression}" />
                                        <!-- 操作盖在算式右端，不另占一列：窄窗口下结果始终完整可见。 -->
                                        <Border x:Name="Actions" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Padding="6,0,0,0" Background="Transparent" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="复制" Style="{StaticResource TapeActionButtonStyle}"
                                                        Click="CopyRecentCalculation_Click" />
                                                <Button Content="复用" Style="{StaticResource TapeActionButtonStyle}"
                                                        Click="ReuseCalculation_Click" />
                                                <Button Content="×" Style="{StaticResource TapeActionButtonStyle}"
                                                        AutomationProperties.Name="删除" ToolTip="删除这条记录"
                                                        Click="DeleteCalculation_Click" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="190"
                                                   Text="{Binding DisplayText}" ToolTip="{Binding FullValueText}"
                                                   FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Actions" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="CalculationEmptyText" Text="还没有计算记录" IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource LabelTertiaryBrush}" />
                    </Grid>

                    <!-- 当前输入 + 实时结果：输入框、退格、键盘开关；下面一行是 = 结果 与"复制结果"。 -->
                    <Border Grid.Row="2" Margin="0,4,0,0" Padding="12,2,8,8"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CalculatorExpressionBox" MaxLength="512" VerticalContentAlignment="Center"
                                         Style="{StaticResource CalculatorInputTextBoxStyle}"
                                         ToolTip="输入算式，例如 (1250+380)/3；Enter 记录并继续，Ctrl+Enter 复制结果，↑ 调出上一条"
                                         AutomationProperties.Name="计算算式"
                                         PreviewKeyDown="CalculatorExpressionBox_PreviewKeyDown"
                                         PreviewTextInput="CalculatorExpressionBox_PreviewTextInput"
                                         TextChanged="CalculatorExpressionBox_TextChanged" />
                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE750;"
                                        AutomationProperties.Name="退格" ToolTip="退格" Tag="back"
                                        Click="CalculatorKey_Click" />
                                <ToggleButton x:Name="CalculatorKeypadToggle" Grid.Column="2" Content="&#xE765;"
                                              Style="{StaticResource IconToggleButtonStyle}"
                                              AutomationProperties.Name="小键盘" ToolTip="展开或收起小键盘（记住上次状态）"
                                              Checked="CalculatorKeypadToggle_Changed" Unchecked="CalculatorKeypadToggle_Changed" />
                            </Grid>
                            <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" />
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CalculatorResultText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Typography.NumeralAlignment="Tabular" AutomationProperties.Name="计算结果"><Run x:Name="CalculatorResultRun" /><Run x:Name="CalculatorExpandedRun" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource LabelTertiaryBrush}" /></TextBlock>
                                <Button x:Name="CopyCalculatorUppercaseButton" Grid.Column="1" Margin="10,0,0,0" Padding="10,0" Height="32"
                                        Content="大写" IsEnabled="False"
                                        AutomationProperties.Name="复制大写金额"
                                        ToolTip="复制报销单大写金额，如 壹仟贰佰叁拾肆元伍角整，并记到纸带（Ctrl+Shift+Enter）"
                                        Click="CopyCalculatorUppercaseButton_Click" />
                                <Button x:Name="CopyCalculatorValueButton" Grid.Column="2" Margin="6,0,0,0" Padding="12,0" Height="32"
                                        Content="复制结果" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}"
                                        ToolTip="复制结果并记到纸带（Ctrl+Enter）" Click="CopyCalculatorValueButton_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 小键盘：默认收起，4×5。"( )" 一次插入一对括号，"=" 同 Enter。 -->
                    <UniformGrid x:Name="CalculatorKeypad" Grid.Row="3" Columns="4" Rows="5" Margin="-2,2,-2,0" Visibility="Collapsed">
                        <Button Content="清空" Tag="clear" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="⌫" Tag="back" AutomationProperties.Name="退格键" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="%" Tag="%" AutomationProperties.Name="百分号" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="÷" Tag="÷" AutomationProperties.Name="除" Style="{StaticResource KeypadOperatorKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="7" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="8" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="9" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="×" Tag="×" AutomationProperties.Name="乘" Style="{StaticResource KeypadOperatorKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="4" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="5" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="6" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="−" Tag="-" AutomationProperties.Name="减" Style="{StaticResource KeypadOperatorKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="1" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="2" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="3" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="+" Tag="+" AutomationProperties.Name="加" Style="{StaticResource KeypadOperatorKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="( )" Tag="()" AutomationProperties.Name="括号" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="0" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="." Tag="." AutomationProperties.Name="小数点" Style="{StaticResource KeypadKeyStyle}" Click="CalculatorKey_Click" />
                        <Button Content="=" Tag="enter" AutomationProperties.Name="等于" Style="{StaticResource KeypadPrimaryKeyStyle}" Click="CalculatorKey_Click" />
                    </UniformGrid>
                </Grid>

                <!-- 共享页：发布 / 订阅两段。颜色、圆角全部来自主题 token；行按钮的 Click 在代码里取行的 DataContext。 -->
                <Grid x:Name="SharePanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel>
                            <RadioButton x:Name="SharePublishChip" Style="{StaticResource FilterChipStyle}"
                                         GroupName="ShareSegment" IsChecked="True" Content="发布"
                                         Click="SharePublishChip_Click" AutomationProperties.Name="发布段" />
                            <RadioButton x:Name="ShareSubscribeChip" Style="{StaticResource FilterChipStyle}"
                                         GroupName="ShareSegment" Content="订阅"
                                         Click="ShareSubscribeChip_Click" AutomationProperties.Name="订阅段" />
                        </WrapPanel>
                        <TextBlock x:Name="ShareStatusText" Grid.Column="1" Margin="8,0,2,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource MetaTextStyle}" Text="未监听" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- 发布 -->
                        <ScrollViewer x:Name="SharePublishScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,4,8">
                                <TextBlock Margin="2,0,0,6" Style="{StaticResource SecondaryTextStyle}" Text="我发布的配置" />
                                <ItemsControl x:Name="PublishedList" ItemsSource="{Binding PublishedRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ShareCardStyle}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrandStrongBrush}" Text="{Binding VersionText}" />
                                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}"
                                                                   ToolTip="{Binding Name}" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,2,0,6" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"
                                                               Text="{Binding Detail}" />
                                                    <WrapPanel>
                                                        <Button Style="{StaticResource TapeActionButtonStyle}" Margin="0,0,6,4" Content="发布新版本"
                                                                Click="PublishNewVersion_Click" AutomationProperties.Name="发布新版本" />
                                                        <Button Style="{StaticResource TapeActionButtonStyle}" Margin="0,0,6,4" Content="停止发布"
                                                                Click="StopPublishing_Click" AutomationProperties.Name="停止发布" />
                                                        <CheckBox Margin="0,0,0,4" VerticalAlignment="Center" Content="改动后自动发布"
                                                                  IsChecked="{Binding AutoPublish, Mode=OneWay}" Click="AutoPublishCheck_Click"
                                                                  ToolTip="配置文件夹改动后 60 秒内没有新改动，才发布新版本" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="SharePublishEmptyText" Margin="2,0,0,8" Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" Text="还没有发布。默认一次发布个人的全部配置（可取消勾选部分文件夹），作为同一个版本；订阅方只读，不会改动你的配置。" />
                                <Button x:Name="SharePublishNewButton" HorizontalAlignment="Left" Margin="0,0,0,14" Padding="12,5"
                                        Style="{StaticResource PrimaryButtonStyle}" Content="发布配置…"
                                        Click="SharePublishNewButton_Click" />

                                <TextBlock Margin="2,0,0,6" Style="{StaticResource SecondaryTextStyle}" Text="配对订阅设备" />
                                <Border Style="{StaticResource ShareCardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="ShareLocalAddressText" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"
                                                   Text="本机地址未知" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SharePairingCodeText" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       FontSize="{DynamicResource FontSizeTitle}" Typography.NumeralAlignment="Tabular"
                                                       AutomationProperties.Name="配对码" Text="——" />
                                            <Button x:Name="ShareIssueCodeButton" Grid.Column="1" Padding="12,4"
                                                    Content="生成配对码" Click="ShareIssueCodeButton_Click" />
                                        </Grid>
                                        <TextBlock x:Name="SharePairingHintText" Margin="0,4,0,0" Style="{StaticResource MetaTextStyle}"
                                                   TextWrapping="Wrap" Text="对方在“订阅”页输入本机地址和配对码；码 5 分钟有效，输错 5 次作废。" />
                                        <Button x:Name="ShareCopyFirewallButton" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Style="{StaticResource TapeActionButtonStyle}" Content="复制防火墙放行命令"
                                                Click="ShareCopyFirewallButton_Click"
                                                ToolTip="在管理员 PowerShell 里运行，放行 TCP/UDP 53318" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="2,10,0,6" Style="{StaticResource SecondaryTextStyle}" Text="已配对的订阅设备" />
                                <ItemsControl x:Name="SubscriberList" ItemsSource="{Binding SubscriberRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ShareCardStyle}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource TapeActionButtonStyle}" Margin="8,0,0,0"
                                                            VerticalAlignment="Center" Content="移除" Click="RemoveSubscriber_Click"
                                                            AutomationProperties.Name="移除订阅设备" />
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource MetaTextStyle}"
                                                                   TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ShareSubscriberEmptyText" Margin="2,0,0,0" Style="{StaticResource MetaTextStyle}"
                                           Text="还没有设备订阅你的配置" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 订阅 -->
                        <ScrollViewer x:Name="ShareSubscribeScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,4,8">
                                <TextBlock Margin="2,0,0,6" Style="{StaticResource SecondaryTextStyle}" Text="我的订阅" />
                                <ItemsControl x:Name="SubscriptionList" ItemsSource="{Binding SubscriptionRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ShareCardStyle}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrandStrongBrush}" Text="{Binding VersionText}" />
                                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}"
                                                                   ToolTip="{Binding Name}" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Detail}" ToolTip="{Binding Detail}" />
                                                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding StatusText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource LabelSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,6" Style="{StaticResource MetaTextStyle}" Text="{Binding OptionsText}" />
                                                    <WrapPanel>
                                                        <Button Style="{StaticResource TapeActionButtonStyle}" Margin="0,0,6,4" Content="检查更新"
                                                                Click="CheckSubscription_Click" AutomationProperties.Name="检查更新" />
                                                        <Button Style="{StaticResource TapeActionButtonStyle}" Margin="0,0,6,4" Content="更新"
                                                                Visibility="{Binding UpdateButtonVisibility}" Click="UpdateSubscription_Click"
                                                                AutomationProperties.Name="更新到最新版本" />
                                                        <Button Style="{StaticResource TapeActionButtonStyle}" Margin="0,0,6,4" Content="回退"
                                                                IsEnabled="{Binding CanRollback}" Click="RollbackSubscription_Click"
                                                                AutomationProperties.Name="回退到上一版本" />
                                                        <Button Style="{StaticResource TapeActionButtonStyle}" Margin="0,0,0,4" Content="设置…"
                                                                Click="SubscriptionSettings_Click" AutomationProperties.Name="订阅设置" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ShareSubscriptionEmptyText" Margin="2,0,0,12" Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" Text="还没有订阅。配对一台发布设备后，可以订阅它发布的配置。" />

                                <TextBlock Margin="2,0,0,6" Style="{StaticResource SecondaryTextStyle}" Text="附近的发布者" />
                                <ItemsControl x:Name="PublisherList" ItemsSource="{Binding PublisherRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ShareCardStyle}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource TapeActionButtonStyle}" Margin="8,0,0,0"
                                                            VerticalAlignment="Center" Content="{Binding ActionText}" Click="PublisherAction_Click" />
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding DeviceName}" />
                                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource MetaTextStyle}"
                                                                   TextTrimming="CharacterEllipsis" Text="{Binding Detail}" ToolTip="{Binding Detail}" />
                                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource MetaTextStyle}"
                                                                   TextTrimming="CharacterEllipsis" Text="{Binding PublicationsText}"
                                                                   ToolTip="{Binding PublicationsText}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="SharePublisherEmptyText" Margin="2,0,0,8" Style="{StaticResource MetaTextStyle}"
                                           TextWrapping="Wrap" Text="没有发现附近的发布者。网络屏蔽组播时，请在下面手动输入对方的 IP:端口。" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ShareManualAddressBox" Style="{StaticResource SearchTextBoxStyle}"
                                             Tag="IP:端口，如 192.168.1.20:53318" Margin="0,0,6,0"
                                             AutomationProperties.Name="发布者地址"
                                             KeyDown="ShareManualAddressBox_KeyDown" />
                                    <Button x:Name="ShareManualConnectButton" Grid.Column="1" Padding="12,4" Content="连接"
                                            Click="ShareManualConnectButton_Click" />
                                </Grid>

                                <TextBlock Margin="2,0,0,6" Style="{StaticResource SecondaryTextStyle}" Text="已配对的发布设备" />
                                <ItemsControl x:Name="PairedPublisherList" ItemsSource="{Binding PairedPublisherRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ShareCardStyle}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                    <TextBlock Margin="0,2,0,6" Style="{StaticResource MetaTextStyle}"
                                                               TextTrimming="CharacterEllipsis" Text="{Binding Detail}" ToolTip="{Binding Detail}" />
                                                    <WrapPanel>
                                                        <Button Style="{StaticResource TapeActionButtonStyle}" Margin="0,0,6,0" Content="浏览发布"
                                                                Click="BrowsePublisher_Click" AutomationProperties.Name="浏览发布" />
                                                        <Button Style="{StaticResource TapeActionButtonStyle}" Margin="0" Content="移除配对"
                                                                Click="RemovePublisher_Click" AutomationProperties.Name="移除配对" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="SharePairedEmptyText" Margin="2,0,0,0" Style="{StaticResource MetaTextStyle}"
                                           Text="还没有配对过发布设备" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

            </Grid>

            <Border Grid.Row="3" Margin="0,4,0,0" Padding="10,4" Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
                <Grid x:Name="FooterContentGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
