FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY Directory.Packages.props ./
COPY cloud/ClipboardManager.Cloud.Api/ cloud/ClipboardManager.Cloud.Api/
COPY cloud/migrations/ cloud/migrations/
RUN dotnet restore cloud/ClipboardManager.Cloud.Api/ClipboardManager.Cloud.Api.csproj
RUN dotnet publish cloud/ClipboardManager.Cloud.Api/ClipboardManager.Cloud.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "ClipboardManager.Cloud.Api.dll"]
