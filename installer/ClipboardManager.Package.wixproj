<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.8.0</PackageVersion>
    <OutputName>ClipboardManager-$(PackageVersion)-win-x64</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <PublishDir>$(MSBuildThisFileDirectory)..\artifacts\publish\$(PackageVersion)\msi-single</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir);PackageVersion=$(PackageVersion);SourceDir=$(MSBuildThisFileDirectory)..</DefineConstants>
    <SuppressIces>ICE91</SuppressIces>
  </PropertyGroup>
</Project>
